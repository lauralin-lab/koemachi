# Copy this file to .env (which git ignores) and fill it in. Koemachi talks to Thinking Machines' Inkling through Tinker's Anthropic-compatible
# Messages API; the local server (node site/serve.js) reads these and adds the key, so the key never reaches the browser.
TINKER_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/anthropic/api
TINKER_API_KEY=put-your-tinker-key-here
# optional (this is the default):
# TINKER_MODEL=thinkingmachines/Inkling-2-Small
# optional: another port for the local server, or another place for the env file
# PORT=8080
# SW_ENV_FILE=/path/to/another/env/file
